   "source": [
    "total_cost = 0\n",
    "while True:\n",
    "    out = client.chat.completions.parse(\n",
    "        model = 'openai/gpt-5.5',\n",
    "        messages = messages,\n",
    "        tools = tools\n",
    "    )\n",
    "\n",
    "    messages.append(out.choices[0].message.model_dump())\n",
    "\n",
    "    print('======================')\n",
    "    print('=  ChatGPT response  =')\n",
    "    print('======================')\n",
    "    total_cost += out.usage.cost\n",
    "    print(f'Prompt tokens: {out.usage.prompt_tokens}. Completion tokens: {out.usage.completion_tokens}. Cost: {out.usage.cost}. Total cost so far: {total_cost}')\n",
    "    print()\n",
    "\n",
    "    print(out.choices[0].message.content)\n",
    "    print()\n",
    "\n",
    "    tool_calls = out.choices[0].message.tool_calls\n",
    "    if tool_calls != None:\n",
    "        for tool in tool_calls:\n",
    "            tool_id = tool.id\n",
    "            function_name = tool.function.name\n",
    "            function_args = tool.function.parsed_arguments.model_dump()\n",
    "\n",
    "            print(f'Calling tool {function_name} with the following arguments: {function_args}')\n",
    "\n",
    "            try:\n",
    "                if function_name == 'EventDate':\n",
    "                    tool_out = api_client.event_date(**function_args)\n",
    "                elif function_name == 'GetEventLink':\n",
    "                    tool_out = api_client.get_event_link(**function_args)\n",
    "                elif function_name == 'SendText':\n",
    "                    tool_out = api_client.send_text(**function_args)\n",
    "                elif function_name == 'SendSlackMessage':\n",
    "                    tool_out = api_client.send_slack(**function_args)\n",
    "                elif function_name == 'SendEmail':\n",
    "                    tool_out = api_client.send_email(**function_args)\n",
    "                elif function_name == 'GoogleMapsSearch':\n",
    "                    tool_out = api_client.maps_places_search(**function_args)\n",
    "                elif function_name == 'GoogleMapsTravelDistance':\n",
    "                    tool_out = api_client.maps_routes_travel_time(**function_args)\n",
    "                elif function_name == 'GoogleMapsWeather':\n",
    "                    tool_out = api_client.maps_weather(**function_args)\n",
    "\n",
    "            except:\n",
    "                tool_out = '**Error** calling the function'\n",
    "\n",
    "            print(f'Tool response: {tool_out}')\n",
    "\n",
    "            messages.append({'role' : 'tool',\n",
    "                        'tool_call_id' : tool_id,\n",
    "                         'content' : str(tool_out)})\n",
    "\n",
    "            print()\n",
    "\n",
    "        continue\n",
    "\n",
    "    print('======================')\n",
    "    print('=    User message    =')\n",
    "    print('======================')\n",
    "    print()\n",
    "    next_message = input('').strip()\n",
    "    print(next_message)\n",
    "    print()\n",
    "\n",
    "    if next_message.strip() != '':\n",
    "        messages.append({'role':'user', 'content':next_message.strip()})\n",
    "\n",
    "    else:\n",
    "        break\n",
    "        "
   ]
