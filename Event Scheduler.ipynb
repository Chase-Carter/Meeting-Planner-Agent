   "source": [
    "import pydantic\n",
    "import openai\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "26278b3a-fede-4709-b112-c8111afe01b0",
   "metadata": {},
   "outputs": [],
   "source": [
    "class EventDate(pydantic.BaseModel):\n",
    "    year : int = pydantic.Field(description = \"Format: 2025\")\n",
    "    month : int = pydantic.Field(description = \"As a number\")\n",
    "    day : int\n",
    "    hour : int = pydantic.Field(description = \"24 hour format\")\n",
    "    minute : int\n",
    "\n",
    "class GetEventLink(pydantic.BaseModel):\n",
    "    '''\n",
    "    This function gets the details of an event. It then returns a link the user\n",
    "    can click to create a pre-populated Google calendar event that they can add\n",
    "    to their calendar.\n",
    "    '''\n",
    "                                \n",
    "class SendText(pydantic.BaseModel):\n",
    "    '''\n",
    "    Sends a text message. Don't send URLs in text messages.\n",
    "    '''\n",
    "    \n",
    "    phone_number : str = pydantic.Field(description = \"Phone number in the format +1XXXXXXX. Only US numbers\")\n",
    "    message : str = pydantic.Field(description = \"Message to send. Must be 160 characters or fewer\")\n",
    "\n",
    "class SendSlackMessage(pydantic.BaseModel):\n",
    "    '''\n",
    "    Sends a Slack message\n",
    "    '''\n",
    "    \n",
    "    message : str\n",
    "\n",
    "class SendEmail(pydantic.BaseModel):\n",
    "    '''\n",
    "    Sends a an email\n",
    "    '''\n",
    "    \n",
    "    send_to_address : str\n",
    "    email_subject : str\n",
    "    email_text : str\n",
    "\n",
    "class GoogleMapsSearch(pydantic.BaseModel):\n",
    "    '''\n",
    "    Runs a google maps search. Has the option to restricth the result to a certain radius of a geographic location.\n",
    "    Returns information about the location, including a Google place_id\n",
    "    '''\n",
    "    \n",
    "    query : str\n",
    "    restriction_latitude : float | None = None\n",
    "    restriction_longitude : float | None = None\n",
    "    restriction_radius_meters : float | None = None\n",
    "\n",
    "class GoogleMapsTravelDistance(pydantic.BaseModel):\n",
    "    '''\n",
    "    Finds the travel distance between two Google place_ids\n",
    "    '''\n",
    "    \n",
    "    origin_place_id : str\n",
    "    destination_place_id : str\n",
    "    travel_mode : str | None = pydantic.Field(default=None, description = 'The mode of travel. Allowed modes are: WALK, BICYCLE, and DRIVE')\n",
    "\n",
    "class GoogleMapsWeather(pydantic.BaseModel):\n",
    "    '''\n",
    "    Finds the current or forecasted weather from the google maps API. Maximum: 10 days out\n",
    "    '''\n",
    "\n",
    "    latitude : float\n",
    "    longitude : float\n",
    "    forecast_until : str | None = pydantic.Field(default = None, description = \"If provided, should be in the format YYYY-MM-DD,HH:MM. \"\n",
    "                                                                                \"Hourly forecasts will be returned between now, and the date in question\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "3f4d4d5f-8119-4ba4-831d-01f98f5cda45",
   "metadata": {},
   "outputs": [],
   "source": [
    "tools = [openai.pydantic_function_tool(EventDate),\n",
    "         openai.pydantic_function_tool(GetEventLink),\n",
    "         openai.pydantic_function_tool(SendText),\n",
    "         openai.pydantic_function_tool(SendSlackMessage),\n",
    "         openai.pydantic_function_tool(SendEmail),\n",
    "         openai.pydantic_function_tool(GoogleMapsSearch),\n",
    "         openai.pydantic_function_tool(GoogleMapsTravelDistance),\n",
    "         openai.pydantic_function_tool(GoogleMapsWeather),\n",
    "]"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "id": "95ecb517-98a7-4c73-9dde-88a3bcd2bdad",
   "metadata": {},
   "outputs": [],
   "source": [
    "with open(r\"ENTER PATH HERE", 'r') as f:\n",
    "    key_API = f.read().strip()\n",
    "\n",
    "import xlkitlearn_api\n",
    "api_client = xlkitlearn_api.APIGateway(api_key=key_API)\n",
    "client = openai.OpenAI(base_url=\"https://openrouter.ai/api/v1\", api_key=key_API)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 5,
   "id": "c8cba6f5-b32e-45a2-962a-0c3aeaca4fad",
   "metadata": {},
   "outputs": [],
   "source": [
    "agent_instructions = (\n",
    "                       \"You are a helpful assistant that will assist a user in creating Google calendar \"\n",
    "                       \"events for a meeting they've scheduled. Please start by having a conversation with \"\n",
    "                       \"the user to figure out a place for the event to happen, its time and date, the \"\n",
    "                       \"event title, and the address they will be coming from. Once those details are \"\n",
    "                       \"figured out, find the time it would take to travel between the two and the weather \"\n",
    "                       \"at the destinatio at the time if you can. Once you've figured everything out, email \"\n",
    "                       \"the user with a summary of everything, and a link to create two Google calendar events - \"\n",
    "                       \"one for the travel time, and one for the actual meeting. Also send quick one-line text \"\n",
    "                       \"messages and slack messages to confirm the meeting has been booked.\"\n",
    ")"
   ]
  },
  {
